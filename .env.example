NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=

# Public site origin used for Stripe redirect URLs (production: https://www.geta11yfix.com)
# NEXT_PUBLIC_APP_URL=https://www.geta11yfix.com

# Stripe. Use sk_test_ / price_… for local testing, then switch Vercel Production
# to Live keys (sk_live_, whsec_ from a Live webhook endpoint, live price id).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=

# Server only. Used by billing webhooks and `npm run dev:link`. Never expose as NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=
